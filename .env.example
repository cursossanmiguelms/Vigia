# VigIA - copia este archivo como .env y completa tus valores.
# NUNCA subas .env al repositorio.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
# JWT heredado de service_role (el REST legado lo acepta).
SUPABASE_SERVICE_ROLE_KEY=eyJxxx
SUPABASE_CAPTURES_BUCKET=captures
SUPABASE_PROJECT_REF=<project-ref>
# Token personal de Supabase, solo para la Management API local.
SUPABASE_ACCESS_TOKEN=sbp_v0_xxx
